---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PhoneButton from '../../components/PhoneButton.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import WrittenDirections from '../../components/WrittenDirections.astro';
import MapFacade from '../../components/MapFacade.astro';
import { getAllBusinessSlugs, getBusinessData, getAllDirectorySlugs, getDirectoryData } from '../../lib/firestore';

export async function getStaticPaths() {
  const slugs = await getAllBusinessSlugs();
  const allSlugs = await getAllBusinessSlugs();
  
  const paths = [];
  for (const slug of slugs) {
    // Fetch all other businesses for related links
    const otherBusinesses = [];
    for (const otherSlug of allSlugs) {
      if (otherSlug === slug) continue;
      const otherBiz = await getBusinessData(otherSlug);
      if (otherBiz) {
        otherBusinesses.push({ slug: otherSlug, ...otherBiz });
      }
    }
    
    paths.push({ 
      params: { business: slug },
      props: { otherBusinesses }
    });
  }
  
  return paths;
}

const { business } = Astro.params;
const { otherBusinesses } = Astro.props;
const data = await getBusinessData(business!);

if (!data) {
  return Astro.redirect('/404');
}

const isVerified = data.verified === true;
const gallery = data.gallery || [];

// Related directories at same location
const allDirs = await getAllDirectorySlugs();
const relatedDirs = [];
for (const dirSlug of allDirs) {
  const dirData = await getDirectoryData(dirSlug);
  if (dirData && data.location && dirData.locationDisplay?.toLowerCase() === data.location.toLowerCase()) {
    relatedDirs.push(dirData);
  }
}

// Related businesses: same location OR same category
const sameLocationBiz = (otherBusinesses || []).filter(
  (b: any) => b.location && data.location && 
  b.location.toLowerCase() === data.location.toLowerCase()
);

const sameCategoryBiz = (otherBusinesses || []).filter(
  (b: any) => b.category && data.category && 
  b.category.toLowerCase() === data.category.toLowerCase() &&
  b.location?.toLowerCase() !== data.location?.toLowerCase()
);

const pageTitle = data.name + ' — ' + (data.tagline || 'Welcome');
const pageDescription = data.description?.substring(0, 160) || '';

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: data.name,
  description: data.description,
  image: data.heroImage || undefined,
  telephone: data.phone || undefined,
  address: data.location ? {
    '@type': 'PostalAddress',
    addressLocality: data.location,
    addressCountry: 'KE'
  } : undefined,
  geo: data.coordinates ? {
    '@type': 'GeoCoordinates',
    latitude: data.coordinates.lat,
    longitude: data.coordinates.lng
  } : undefined,
  openingHours: data.openingHours ? [
    data.openingHours.weekdays ? 'Mo-Fr ' + data.openingHours.weekdays : null,
    data.openingHours.saturday ? 'Sa ' + data.openingHours.saturday : null,
    data.openingHours.sunday ? 'Su ' + data.openingHours.sunday : null
  ].filter(Boolean) : undefined,
  priceRange: data.priceRange || undefined
};

const faqSchema = data.faqs && data.faqs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: data.faqs.map(faq => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer }
  }))
} : null;

const articleSchema = data.blog?.title ? {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.blog.title,
  dateModified: data.blog.lastModified,
  author: { '@type': 'Organization', name: 'Kenya Accommodation & Business Directory' },
  mainEntityOfPage: { '@type': 'WebPage', '@id': `${Astro.url.origin}/business/${business}/` }
} : null;

const allPhotos: any[] = [];
gallery.forEach((cat: any) => {
  cat.photos.forEach((photo: any) => {
    allPhotos.push({ src: photo.src, alt: photo.alt || cat.category, category: cat.category });
  });
});
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  ogImage={data.heroImage}
  canonicalURL={`${Astro.url.origin}/business/${business}/`}
  geoCoordinates={data.coordinates}
  geoPlacename={data.location ? data.location + ', Kenya' : 'Kenya'}
>
  <slot name="head">
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
    {articleSchema && <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />}
  </slot>

  <Header breadcrumbs={[{ label: 'Home', url: '/' }, { label: data.name }]} />

  <main>
    <section style="background:white; border-radius:12px; overflow:hidden; box-shadow:0 2px 8px rgba(0,0,0,0.08); margin-bottom:1.5rem;">
      {data.heroImage && (
        <img src={data.heroImage} alt={data.heroImageAlt || data.name} width="800" height="400" loading="eager" style="border-radius:0; width:100%; max-height:400px; object-fit:cover;" />
      )}
      <div style="padding:1.5rem; text-align:center;">
        <h1 style="font-size:1.8rem; margin-bottom:0.5rem; line-height:1.3;">
          {data.name}
          {isVerified && <span style="background:#1a7a3a; color:white; padding:0.2rem 0.6rem; border-radius:20px; font-size:0.8rem; margin-left:0.5rem; vertical-align:middle;">✓ Verified</span>}
        </h1>
        {data.tagline && <p style="font-size:1.05rem; color:#666; font-style:italic; margin:0.25rem 0;">{data.tagline}</p>}
        {data.category && <span style="background:#0066cc; color:white; padding:0.3rem 1rem; border-radius:20px; font-size:0.85rem; display:inline-block; margin-top:0.5rem;">{data.category}</span>}
      </div>
    </section>

    {isVerified ? (
      <div style="display:flex; gap:0.75rem; justify-content:center; flex-wrap:wrap; margin:1.25rem 0;">
        {data.phone && <PhoneButton phone={data.phone} display={data.phoneDisplay || data.phone} />}
        {data.whatsapp && <WhatsAppButton number={data.whatsapp} message={data.whatsappMessage || 'Hello, I visited your website.'} />}
      </div>
    ) : (
      <div style="display:flex; gap:0.75rem; justify-content:center; flex-wrap:wrap; margin:1.25rem 0; position:relative; opacity:0.6;">
        <span style="background:#28a745; color:white; padding:0.75rem 1.5rem; border-radius:4px; font-weight:bold; min-width:150px; text-align:center; pointer-events:none;">📞 Call</span>
        <span style="background:#25D366; color:white; padding:0.75rem 1.5rem; border-radius:4px; font-weight:bold; min-width:150px; text-align:center; pointer-events:none;">💬 WhatsApp</span>
        <span style="position:absolute; top:50%; left:50%; transform:translate(-50%, -50%); background:#333; color:white; padding:0.5rem 1rem; border-radius:20px; font-size:0.85rem; font-weight:600;">🔒 Contact for Verified Businesses</span>
      </div>
    )}

    {data.openingHours && (
      <section style="background:white; padding:1.25rem; border-radius:12px; box-shadow:0 2px 8px rgba(0,0,0,0.08); margin:1rem 0; text-align:center;">
        <h2 style="margin-top:0; font-size:1.2rem; color:#003d80;">🕐 Opening Hours</h2>
        <p style="margin:0.35rem 0;"><strong>Mon-Fri:</strong> {data.openingHours.weekdays || 'N/A'}</p>
        <p style="margin:0.35rem 0;"><strong>Saturday:</strong> {data.openingHours.saturday || 'N/A'}</p>
        <p style="margin:0.35rem 0;"><strong>Sunday:</strong> {data.openingHours.sunday || 'N/A'}</p>
      </section>
    )}

    {data.description && (
      <section style="background:white; padding:1.25rem; border-radius:12px; box-shadow:0 2px 8px rgba(0,0,0,0.08); margin:1rem 0;">
        <h2 style="margin-top:0; font-size:1.3rem;">About {data.name}</h2>
        <p style="font-size:1.05rem; line-height:1.8; color:#444; margin-top:0.5rem;">{data.description}</p>
      </section>
    )}

    {data.services && data.services.length > 0 && (
      <section style="background:white; padding:1.25rem; border-radius:12px; box-shadow:0 2px 8px rgba(0,0,0,0.08); margin:1rem 0;">
        <h2 style="margin-top:0; font-size:1.3rem;">What We Offer</h2>
        <div style="display:flex; flex-wrap:wrap; gap:0.5rem; margin-top:0.75rem;">
          {data.services.map((s: string) => (
            <span style="background:#f0f4ff; color:#003d80; padding:0.3rem 0.8rem; border-radius:20px; font-size:0.85rem;">✓ {s}</span>
          ))}
        </div>
      </section>
    )}

    {isVerified && gallery.length > 0 && (
      <section style="background:white; padding:1.25rem; border-radius:12px; box-shadow:0 2px 8px rgba(0,0,0,0.08); margin:1rem 0;">
        <h2 style="margin-top:0; font-size:1.3rem;">📸 Photo Gallery</h2>
        <p style="color:#666; font-size:0.9rem; margin:0.5rem 0;">Click a category to view photos. Tap any photo to enlarge.</p>
        {gallery.map((cat: any) => (
          <details style="margin:0.5rem 0; border:1px solid #e0e0e0; border-radius:10px; overflow:hidden;">
            <summary style="padding:0.75rem 1rem; cursor:pointer; font-weight:600; color:#003d80; list-style:none; display:flex; align-items:center; gap:0.5rem; background:#f8f8f8;">
              📁 {cat.category} ({cat.photos.length} photos)
            </summary>
            <div style="padding:0.75rem; display:grid; grid-template-columns:repeat(auto-fit, minmax(150px, 1fr)); gap:0.5rem;">
              {cat.photos.map((photo: any) => (
                <img 
                  src={photo.src} 
                  alt={photo.alt || cat.category} 
                  width="300" height="225" 
                  loading="lazy" 
                  class="gallery-photo"
                  style="border-radius:8px; width:100%; object-fit:cover; cursor:pointer;" 
                  data-photo-src={photo.src}
                  data-photo-alt={photo.alt || cat.category}
                />
              ))}
            </div>
          </details>
        ))}
      </section>
    )}

    {!isVerified && gallery.length > 0 && (
      <section style="background:#f8f8f8; padding:1.25rem; border-radius:12px; margin:1rem 0; text-align:center; position:relative; opacity:0.6;">
        <h2 style="margin-top:0; font-size:1.3rem;">📸 Photo Gallery</h2>
        <p style="margin:0.5rem 0;">More photos available for Verified Businesses</p>
        <span style="display:inline-block; background:#333; color:white; padding:0.3rem 0.8rem; border-radius:20px; font-size:0.8rem;">🔒 Locked</span>
      </section>
    )}

    {data.directions && <WrittenDirections directions={data.directions} />}
    
    {isVerified ? (
      <MapFacade lat={data.coordinates.lat} lng={data.coordinates.lng} name={data.name} />
    ) : (
      <div style="margin:1rem 0; padding:1rem; background:#f8f8f8; border-radius:10px; text-align:center; position:relative; opacity:0.6;">
        <p style="margin:0; font-weight:600;">🗺️ Map available for Verified Businesses</p>
        <span style="display:inline-block; margin-top:0.5rem; background:#333; color:white; padding:0.3rem 0.8rem; border-radius:20px; font-size:0.8rem;">🔒 Locked</span>
      </div>
    )}

    {data.faqs && data.faqs.length > 0 && (
      <section style="background:white; padding:1.25rem; border-radius:12px; box-shadow:0 2px 8px rgba(0,0,0,0.08); margin:1rem 0;">
        <h2 style="margin-top:0; font-size:1.3rem;">Frequently Asked Questions</h2>
        {data.faqs.map((faq: any) => (
          <details>
            <summary>{faq.question}</summary>
            <p style="padding:0.5rem 1rem;">{faq.answer}</p>
          </details>
        ))}
      </section>
    )}

    {data.blog?.title && (
      <section style="background:white; border-radius:12px; box-shadow:0 2px 8px rgba(0,0,0,0.08); margin:1.5rem 0; overflow:hidden;">
        <details style="border:none; margin:0; padding:0;">
          <summary style="padding:1.25rem; font-size:1.2rem; font-weight:600; color:#804000; cursor:pointer; background:#fff8f0; border-radius:12px 12px 0 0; list-style:none;">
            📝 Click to Read Full Review
            <span style="display:block; font-size:0.9rem; font-weight:400; color:#666; margin-top:0.25rem;">{data.blog.title}</span>
            <span style="display:inline-block; margin-top:0.5rem; font-size:0.8rem; color:#0066cc;">Tap to expand ↓</span>
          </summary>
          <div style="padding:1.25rem; line-height:1.8;">
            <time datetime={data.blog.lastModified} style="font-size:0.8rem; color:#999;">
              🕐 Last updated: {new Date(data.blog.lastModified).toLocaleDateString('en-KE', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
            <div style="margin-top:1rem;">
              <Fragment set:html={data.blog.bodyHtml || ''} />
            </div>
          </div>
        </details>
      </section>
    )}

    {/* Related directories at same location */}
    {relatedDirs.length > 0 && (
      <section style="background:white; padding:1.25rem; border-radius:12px; box-shadow:0 2px 8px rgba(0,0,0,0.08); margin:1.5rem 0;">
        <h2 style="margin-top:0; font-size:1.3rem; color:#003d80;">📍 Explore Directories in {data.location}</h2>
        <p style="color:#555; margin:0.5rem 0 1rem 0;">Browse other categories in {data.location}.</p>
        <div style="display:flex; flex-wrap:wrap; gap:0.5rem;">
          {relatedDirs.map((dir: any) => (
            <a href={`/${dir.directory}/`} style="display:inline-block; padding:0.5rem 1rem; background:white; border:1px solid #0066cc; color:#0066cc; text-decoration:none; border-radius:20px; font-size:0.9rem;">
              {dir.nicheDisplay} in {dir.locationDisplay}
            </a>
          ))}
        </div>
      </section>
    )}

    {/* Same category, other locations */}
    {sameCategoryBiz.length > 0 && data.category && (
      <section style="background:white; padding:1.25rem; border-radius:12px; box-shadow:0 2px 8px rgba(0,0,0,0.08); margin:1.5rem 0;">
        <h2 style="margin-top:0; font-size:1.3rem; color:#1a7a3a;">🏢 Other {data.category} Businesses in Kenya</h2>
        <p style="color:#555; margin:0.5rem 0 1rem 0;">Similar businesses in other locations.</p>
        <div style="display:flex; flex-wrap:wrap; gap:0.5rem;">
          {sameCategoryBiz.slice(0, 6).map((biz: any) => (
            <a href={`/business/${biz.slug}/`} style="display:inline-block; padding:0.5rem 1rem; background:white; border:1px solid #1a7a3a; color:#1a7a3a; text-decoration:none; border-radius:20px; font-size:0.9rem;">
              {biz.name} {biz.location ? `— ${biz.location}` : ''}
            </a>
          ))}
        </div>
      </section>
    )}

    {/* Other businesses in same location */}
    {sameLocationBiz.length > 0 && (
      <section style="background:white; padding:1.25rem; border-radius:12px; box-shadow:0 2px 8px rgba(0,0,0,0.08); margin:1.5rem 0;">
        <h2 style="margin-top:0; font-size:1.3rem; color:#003d80;">🏢 Other Businesses in {data.location}</h2>
        <p style="color:#555; margin:0.5rem 0 1rem 0;">Discover more businesses in {data.location}.</p>
        <div style="display:flex; flex-wrap:wrap; gap:0.5rem;">
          {sameLocationBiz.slice(0, 6).map((biz: any) => (
            <a href={`/business/${biz.slug}/`} style="display:inline-block; padding:0.5rem 1rem; background:white; border:1px solid #0066cc; color:#0066cc; text-decoration:none; border-radius:20px; font-size:0.9rem;">
              {biz.name}
            </a>
          ))}
        </div>
      </section>
    )}

    <div style="text-align:center; margin:2rem 0;">
      <a href="/" style="display:inline-block; padding:0.75rem 1.5rem; background:#0066cc; color:white; text-decoration:none; border-radius:8px; font-weight:600;">
        ← Back to Home
      </a>
    </div>

    <div id="lightbox" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.95); z-index:9999; align-items:center; justify-content:center; flex-direction:column;">
      <button id="lightboxClose" style="position:absolute; top:15px; right:15px; background:none; border:none; color:white; font-size:2rem; cursor:pointer; z-index:10000;">✕</button>
      <button id="lightboxPrev" style="position:absolute; left:10px; top:50%; transform:translateY(-50%); background:rgba(255,255,255,0.2); border:none; color:white; font-size:2rem; cursor:pointer; padding:0.5rem 1rem; border-radius:50%;">←</button>
      <img id="lightboxImg" src="" alt="" style="max-width:95%; max-height:85%; object-fit:contain; border-radius:8px;" />
      <p id="lightboxCaption" style="color:white; margin-top:1rem; font-size:0.9rem; text-align:center; padding:0 1rem;"></p>
      <button id="lightboxNext" style="position:absolute; right:10px; top:50%; transform:translateY(-50%); background:rgba(255,255,255,0.2); border:none; color:white; font-size:2rem; cursor:pointer; padding:0.5rem 1rem; border-radius:50%;">→</button>
    </div>

    <script set:html={`
      const galleryPhotos = ${JSON.stringify(allPhotos)};
      let currentPhotoIndex = 0;

      function openLightbox(index) {
        currentPhotoIndex = index;
        updateLightbox();
        document.getElementById('lightbox').style.display = 'flex';
        document.body.style.overflow = 'hidden';
      }

      function closeLightbox() {
        document.getElementById('lightbox').style.display = 'none';
        document.body.style.overflow = 'auto';
      }

      function updateLightbox() {
        const photo = galleryPhotos[currentPhotoIndex];
        if (!photo) return;
        document.getElementById('lightboxImg').src = photo.src;
        document.getElementById('lightboxImg').alt = photo.alt;
        document.getElementById('lightboxCaption').textContent = photo.alt + ' (' + (currentPhotoIndex + 1) + '/' + galleryPhotos.length + ')';
      }

      function nextPhoto() {
        currentPhotoIndex = (currentPhotoIndex + 1) % galleryPhotos.length;
        updateLightbox();
      }

      function prevPhoto() {
        currentPhotoIndex = (currentPhotoIndex - 1 + galleryPhotos.length) % galleryPhotos.length;
        updateLightbox();
      }

      document.addEventListener('click', function(e) {
        const img = e.target.closest('.gallery-photo');
        if (img) {
          const src = img.getAttribute('data-photo-src');
          const idx = galleryPhotos.findIndex(p => p.src === src);
          if (idx >= 0) openLightbox(idx);
        }
      });

      document.getElementById('lightboxClose').addEventListener('click', closeLightbox);
      document.getElementById('lightboxNext').addEventListener('click', nextPhoto);
      document.getElementById('lightboxPrev').addEventListener('click', prevPhoto);

      document.addEventListener('keydown', function(e) {
        if (document.getElementById('lightbox').style.display === 'flex') {
          if (e.key === 'Escape') closeLightbox();
          if (e.key === 'ArrowRight') nextPhoto();
          if (e.key === 'ArrowLeft') prevPhoto();
        }
      });
    `} />
  </main>

  <Footer 
    businessName={data.name}
    phone={data.phone}
    phoneDisplay={data.phoneDisplay}
    whatsapp={data.whatsapp}
  />
</BaseLayout>