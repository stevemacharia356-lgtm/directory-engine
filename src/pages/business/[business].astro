---
import { getFirestore } from 'firebase-admin/firestore';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PhoneButton from '../../components/PhoneButton.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import WrittenDirections from '../../components/WrittenDirections.astro';
import MapFacade from '../../components/MapFacade.astro';

export async function getStaticPaths() {
  const db = getFirestore();
  const snapshot = await db.collection('businesses').where('status', '==', 'published').get();
  return snapshot.docs.map(doc => ({ params: { business: doc.id } }));
}

const { business } = Astro.params;
const db = getFirestore();
const doc = await db.collection('businesses').doc(business).get();

if (!doc.exists) {
  return Astro.redirect('/404');
}

const data = doc.data();
const pageTitle = data.name + ' — ' + (data.tagline || 'Welcome');
const pageDescription = data.description?.substring(0, 160) || '';
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  ogImage={data.heroImage}
  canonicalURL={`${Astro.url.origin}/business/${business}/`}
  geoCoordinates={data.coordinates}
  geoPlacename={data.locationDisplay + ', Kenya'}
>
  <Header breadcrumbs={[{ label: 'Home', url: '/' }, { label: data.name }]} />

  <main>
    {/* Hero Section */}
    <section style="text-align:center; padding:2rem 0;">
      {data.heroImage && (
        <img src={data.heroImage} alt={data.heroImageAlt || data.name} width="800" height="400" loading="eager" style="border-radius:8px; width:100%; max-height:400px; object-fit:cover;" />
      )}
      <h1 style="font-size:2rem; margin:1rem 0 0.5rem;">{data.name}</h1>
      {data.tagline && <p style="font-size:1.2rem; color:#666; font-style:italic;">{data.tagline}</p>}
    </section>

    {/* Contact Buttons */}
    <div style="display:flex; gap:1rem; justify-content:center; flex-wrap:wrap; margin:1.5rem 0;">
      {data.phone && <PhoneButton phone={data.phone} display={data.phoneDisplay || data.phone} />}
      {data.whatsapp && <WhatsAppButton number={data.whatsapp} message={data.whatsappMessage || 'Hello, I visited your website.'} />}
    </div>

    {/* About Section */}
    {data.description && (
      <section style="background:#f8f8f8; padding:1.5rem; border-radius:8px; margin:1.5rem 0;">
        <h2 style="color:#333; margin-top:0;">About {data.name}</h2>
        <p style="font-size:1.1rem; line-height:1.8;">{data.description}</p>
      </section>
    )}

    {/* Services Section */}
    {data.services && data.services.length > 0 && (
      <section style="margin:1.5rem 0;">
        <h2 style="color:#333;">What We Offer</h2>
        <div style="display:flex; flex-wrap:wrap; gap:0.75rem;">
          {data.services.map((s: string) => (
            <span style="background:#e8f4e8; padding:0.5rem 1rem; border-radius:20px; font-size:1rem;">✓ {s}</span>
          ))}
        </div>
      </section>
    )}

    {/* Photo Gallery */}
    {data.photos && data.photos.length > 0 && (
      <section style="margin:1.5rem 0;">
        <h2 style="color:#333;">Gallery</h2>
        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(250px, 1fr)); gap:0.5rem;">
          {data.photos.map((photo: any) => (
            <img src={photo.src} alt={photo.alt} width="400" height="300" loading="lazy" style="border-radius:4px; width:100%; object-fit:cover;" />
          ))}
        </div>
      </section>
    )}

    {/* Location */}
    {data.directions && <WrittenDirections directions={data.directions} />}
    {data.coordinates && <MapFacade lat={data.coordinates.lat} lng={data.coordinates.lng} name={data.name} />}

    {/* Blog Section */}
    {data.blog?.title && (
      <section style="background:#fff8f0; padding:1.5rem; border-radius:8px; border-left:6px solid #ff8c00; margin:2rem 0;">
        <h2 style="color:#804000; margin-top:0;">📝 {data.blog.title}</h2>
        <time datetime={data.blog.lastModified} style="font-size:0.8rem; color:#999;">
          🕐 Last updated: {new Date(data.blog.lastModified).toLocaleDateString('en-KE', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
        <div style="margin-top:1rem; line-height:1.8;">
          <Fragment set:html={data.blog.bodyHtml || ''} />
        </div>
      </section>
    )}

    <div style="text-align:center; margin:2rem 0;">
      <a href="/" style="display:inline-block; padding:0.75rem 1.5rem; background:#0066cc; color:white; text-decoration:none; border-radius:4px; font-weight:bold;">
        ← Back to Home
      </a>
    </div>
  </main>

  <Footer />
</BaseLayout>