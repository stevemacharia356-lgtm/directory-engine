---
import { getDirectoryData, getAllDirectorySlugs, getRelatedDirectories } from '../../lib/firestore';
import { getDirectoryConfig } from '../../lib/registry';
import {
  generateLocalBusinessSchema,
  generateHotelSchema,
  generateApartmentSchema,
  generateSchoolSchema,
  generateMedicalSchema,
  generateArticleSchema
} from '../../lib/schema';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PhoneButton from '../../components/PhoneButton.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import WrittenDirections from '../../components/WrittenDirections.astro';
import MapFacade from '../../components/MapFacade.astro';
import ListingFaqs from '../../components/ListingFaqs.astro';
import ChatWidget from '../../components/ChatWidget.astro';

export async function getStaticPaths() {
  const slugs = await getAllDirectorySlugs();
  const paths = [];
  
  for (const dirSlug of slugs) {
    const data = await getDirectoryData(dirSlug);
    if (data && data.listings) {
      let relatedData = { sameNiche: [], sameLocation: [] };
      try {
        relatedData = await getRelatedDirectories(dirSlug, { limit: 6 });
      } catch (e) {
        console.warn(`Could not fetch related for ${dirSlug}:`, e);
      }
      
      for (const listing of data.listings) {
        const otherListings = data.listings.filter((l: any) => l.slug !== listing.slug);
        paths.push({
          params: { directory: dirSlug, slug: listing.slug },
          props: { directoryData: data, listing: listing, relatedData: relatedData, otherListings: otherListings }
        });
      }
    }
  }
  
  return paths;
}

const { directoryData, listing, relatedData, otherListings } = Astro.props;
const { nicheDisplay, locationDisplay, nicheLayout, nicheFieldDefs } = directoryData;
const config = getDirectoryConfig(directoryData.directory);
const niche = listing.nicheSpecific as any;
const isVerified = listing.verified === true;
const gallery = listing.gallery || [];

const sameNiche = relatedData?.sameNiche || [];
const sameLocation = relatedData?.sameLocation || [];
const siblingListings = otherListings || [];

// Default layout (for original 5 niches or if AI layout is missing)
const defaultLayout = {
  listingPage: [
    { section: "hero", fields: [] },
    { section: "primary_actions", fields: [] },
    { section: "photos", fields: [] },
    { section: "decision_facts", fields: ["amenities", "rooms", "services"] },
    { section: "details_table", fields: ["checkIn", "checkOut"] },
    { section: "location", fields: ["directions", "map"] },
    { section: "deep_content", fields: ["faqs", "blog"] }
  ]
};

// Use AI layout if it exists, otherwise use default
const layout = nicheLayout?.listingPage || defaultLayout.listingPage;

const dirLabel = directoryData.categoryTag 
  ? `${directoryData.categoryTag} ${nicheDisplay} in ${locationDisplay}`
  : `${nicheDisplay} in ${locationDisplay}`;

const pageTitle = `${listing.name} — ${dirLabel}`;
const pageDescription = listing.summary;

let schema = null;
if (directoryData.nicheSlug === 'guesthouse') schema = generateLocalBusinessSchema(listing, directoryData.directory);
else if (directoryData.nicheSlug === 'hotel') schema = generateHotelSchema(listing, directoryData.directory);
else if (directoryData.nicheSlug === 'apartment') schema = generateApartmentSchema(listing, directoryData.directory);
else if (directoryData.nicheSlug === 'school') schema = generateSchoolSchema(listing, directoryData.directory);
else if (directoryData.nicheSlug === 'health') schema = generateMedicalSchema(listing, directoryData.directory);
else schema = generateLocalBusinessSchema(listing, directoryData.directory);

const articleSchema = listing.blog?.title ? generateArticleSchema(listing, `${Astro.url.origin}/${directoryData.directory}/${listing.slug}/`) : null;

const allPhotos: any[] = [];
gallery.forEach((cat: any) => {
  cat.photos.forEach((photo: any) => {
    allPhotos.push({ src: photo.src, alt: photo.alt || cat.category, category: cat.category });
  });
});
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  ogImage={listing.thumbnail}
  canonicalURL={`${Astro.url.origin}/${directoryData.directory}/${listing.slug}/`}
  lastModified={listing.lastEditedAt}
  geoCoordinates={listing.coordinates}
  geoPlacename={`${locationDisplay}, Kenya`}
>
  <slot name="head">
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
    {articleSchema && <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />}
  </slot>

  <Header 
    breadcrumbs={[
      { label: 'Home', url: '/' },
      { label: dirLabel, url: `/${directoryData.directory}/` },
      { label: listing.name }
    ]} 
  />

  <main>
    {layout.map((section: any) => {
      // 1. HERO SECTION
      if (section.section === 'hero') {
        return (
          <section style="background:white; border-radius:12px; overflow:hidden; box-shadow:0 2px 8px rgba(0,0,0,0.08); margin-bottom:1.5rem;">
            {listing.thumbnail && (
              <img src={listing.thumbnail} alt={listing.thumbnailAlt} width="800" height="400" loading="eager" style="border-radius:0; width:100%; max-height:400px; object-fit:cover;" />
            )}
            <div style="padding:1.5rem;">
              <h1 style="font-size:1.8rem; margin-bottom:0.5rem; line-height:1.3;">
                {listing.name}
                {isVerified && <span style="background:#1a7a3a; color:white; padding:0.2rem 0.6rem; border-radius:20px; font-size:0.8rem; margin-left:0.5rem; vertical-align:middle;">✓ Verified</span>}
              </h1>
              <p style="font-weight:bold; font-size:1.1rem; color:#1a7a3a; margin:0.5rem 0; background:#e8f4e8; display:inline-block; padding:0.3rem 0.9rem; border-radius:20px;">
                {listing.priceCategory || `KSh ${listing.priceNumeric?.toLocaleString('en-KE')}`}
              </p>
              
              {listing.summary && (
                <div style="margin-top:0.75rem;">
                  <div 
                    id="summaryText" 
                    style={`font-size:1.05rem; color:#444; line-height:1.6; ${listing.summary.length > 180 ? 'display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;' : ''}`}
                  >
                    {listing.summary}
                  </div>
                  
                  {listing.summary.length > 180 && (
                    <button 
                      onclick="toggleSummary()" 
                      id="summaryBtn"
                      style="background:none; border:none; color:#0066cc; font-weight:600; font-size:0.95rem; cursor:pointer; padding:0; margin-top:0.5rem; display:flex; align-items:center; gap:0.25rem;"
                    >
                      Read More <span>↓</span>
                    </button>
                  )}
                </div>
              )}
            </div>
          </section>
        );
      }

      // 2. PRIMARY ACTIONS
      if (section.section === 'primary_actions') {
        return isVerified ? (
          <div style="display:flex; gap:0.75rem; flex-wrap:wrap; margin:1.25rem 0;">
            <PhoneButton phone={listing.phone} display={listing.phoneDisplay} />
            <WhatsAppButton number={listing.whatsapp} message={listing.whatsappMessage} />
          </div>
        ) : (
          <div style="display:flex; gap:0.75rem; flex-wrap:wrap; margin:1.25rem 0; position:relative; opacity:0.6;">
            <span style="background:#28a745; color:white; padding:0.75rem 1.5rem; border-radius:4px; font-weight:bold; min-width:150px; text-align:center; pointer-events:none;">📞 Call</span>
            <span style="background:#25D366; color:white; padding:0.75rem 1.5rem; border-radius:4px; font-weight:bold; min-width:150px; text-align:center; pointer-events:none;">💬 WhatsApp</span>
            <span style="position:absolute; top:50%; left:50%; transform:translate(-50%, -50%); background:#333; color:white; padding:0.5rem 1rem; border-radius:20px; font-size:0.85rem; font-weight:600;">🔒 Contact for Verified Businesses</span>
          </div>
        );
      }

      // 3. PHOTOS (Modern Design)
      if (section.section === 'photos') {
        if (gallery.length === 0) return null;
        return isVerified ? (
          <section style="background:white; padding:1.25rem; border-radius:12px; box-shadow:0 2px 8px rgba(0,0,0,0.08); margin:1rem 0;">
            <h2 style="margin-top:0; font-size:1.3rem;">📸 Photo Gallery</h2>
            <p style="color:#666; font-size:0.9rem; margin:0.5rem 0;">Click a category to view photos. Tap any photo to enlarge.</p>
            {gallery.map((cat: any) => (
              <details style="margin:0.5rem 0; border:1px solid #e0e0e0; border-radius:10px; overflow:hidden;">
                <summary style="padding:0.85rem 1rem; cursor:pointer; font-weight:600; color:#003d80; list-style:none; display:flex; align-items:center; justify-content:space-between; background:#f8f9ff;">
                  <span>{cat.category} <span style="font-weight:400; color:#666; font-size:0.85rem;">({cat.photos.length} photos)</span></span>
                  <span style="font-size:0.8rem; color:#666; font-weight:400;">View ↓</span>
                </summary>
                <div style="padding:0.75rem; display:grid; grid-template-columns:repeat(auto-fit, minmax(150px, 1fr)); gap:0.5rem; background:#fff;">
                  {cat.photos.map((photo: any) => (
                    <img src={photo.src} alt={photo.alt || cat.category} width="300" height="225" loading="lazy" class="gallery-photo" style="border-radius:8px; width:100%; object-fit:cover; cursor:pointer;" data-photo-src={photo.src} data-photo-alt={photo.alt || cat.category} />
                  ))}
                </div>
              </details>
            ))}
          </section>
        ) : (
          <section style="background:#f8f8f8; padding:1.25rem; border-radius:12px; margin:1rem 0; text-align:center; position:relative; opacity:0.6;">
            <h2 style="margin-top:0; font-size:1.3rem;">📸 Photo Gallery</h2>
            <p style="margin:0.5rem 0;">More photos available for Verified Businesses</p>
            <span style="display:inline-block; background:#333; color:white; padding:0.3rem 0.8rem; border-radius:20px; font-size:0.8rem;">🔒 Locked</span>
          </section>
        );
      }

      // 4. DECISION FACTS (Custom Niche)
      if (section.section === 'decision_facts') {
        const fields = section.fields || [];
        const hasData = fields.some((f: string) => niche?.[f] !== undefined && niche?.[f] !== null && niche?.[f] !== '');
        if (!hasData) return null;

        return (
          <section style="background:white; padding:1.25rem; border-radius:12px; box-shadow:0 2px 8px rgba(0,0,0,0.08); margin:1rem 0;">
            <h2 style="margin-top:0; font-size:1.3rem;">Quick Facts</h2>
            <div style="display:flex; flex-wrap:wrap; gap:0.5rem; margin-top:0.75rem;">
              {fields.map((fieldKey: string) => {
                const value = niche?.[fieldKey];
                if (value === undefined || value === null || value === '' || value === false) return null;
                if (Array.isArray(value) && value.length === 0) return null;
                if (Array.isArray(value)) {
                  return value.map((v: string) => <span style="background:#f0f4ff; color:#003d80; padding:0.3rem 0.8rem; border-radius:20px; font-size:0.85rem;">✓ {v}</span>);
                }
                return <span style="background:#f0f4ff; color:#003d80; padding:0.3rem 0.8rem; border-radius:20px; font-size:0.85rem;">✓ {value}</span>;
              })}
            </div>
          </section>
        );
      }

      // 5. DETAILS TABLE (Original 5 + Custom)
      if (section.section === 'details_table') {
        const fields = section.fields || [];
        const isLegacy = directoryData.nicheSlug === 'guesthouse' || directoryData.nicheSlug === 'hotel';
        if (isLegacy && niche?.rooms == null) return null;

        return (
          <section style="background:white; padding:1.25rem; border-radius:12px; box-shadow:0 2px 8px rgba(0,0,0,0.08); margin:1rem 0;">
            <h2 style="margin-top:0; font-size:1.3rem;">Details</h2>
            <div style="margin-top:0.75rem;">
              {niche?.rooms != null && <p style="margin:0.35rem 0;"><strong>Rooms:</strong> {niche.rooms}</p>}
              {niche?.checkIn && <p style="margin:0.35rem 0;"><strong>Check-in:</strong> {niche.checkIn}</p>}
              {niche?.checkOut && <p style="margin:0.35rem 0;"><strong>Check-out:</strong> {niche.checkOut}</p>}
              {niche?.starRating && <p style="margin:0.35rem 0;"><strong>Star Rating:</strong> {niche.starRating} ⭐</p>}
              {niche?.apartmentType && <p style="margin:0.35rem 0;"><strong>Type:</strong> {niche.apartmentType}</p>}
              {niche?.schoolType && <p style="margin:0.35rem 0;"><strong>School Type:</strong> {niche.schoolType}</p>}
              {niche?.curriculum && <p style="margin:0.35rem 0;"><strong>Curriculum:</strong> {niche.curriculum}</p>}
              {niche?.facilityType && <p style="margin:0.35rem 0;"><strong>Facility Type:</strong> {niche.facilityType}</p>}
              {niche?.visitingHours && <p style="margin:0.35rem 0;"><strong>Visiting Hours:</strong> {niche.visitingHours}</p>}
              {niche?.insuranceAccepted && <p style="margin:0.35rem 0;"><strong>Insurance:</strong> {niche.insuranceAccepted}</p>}
              
              {fields.map((fieldKey: string) => {
                const value = niche?.[fieldKey];
                if (value === undefined || value === null || value === '' || value === false) return null;
                if (typeof value === 'string' && (value.toLowerCase() === 'other' || value.toLowerCase() === 'n/a')) return null;
                if (Array.isArray(value) && value.length === 0) return null;
                if (Array.isArray(value)) return null;
                return <p style="margin:0.35rem 0;"><strong>{fieldKey}:</strong> {value}</p>;
              })}
            </div>
          </section>
        );
      }

      // 6. LOCATION
      if (section.section === 'location') {
        return (
          <>
            <WrittenDirections directions={listing.directions} />
            {isVerified ? (
              <MapFacade lat={listing.coordinates.lat} lng={listing.coordinates.lng} name={listing.name} />
            ) : (
              <div style="margin:1rem 0; padding:1rem; background:#f8f8f8; border-radius:10px; text-align:center; position:relative; opacity:0.6;">
                <p style="margin:0; font-weight:600;">🗺️ Map available for Verified Businesses</p>
                <span style="display:inline-block; margin-top:0.5rem; background:#333; color:white; padding:0.3rem 0.8rem; border-radius:20px; font-size:0.8rem;">🔒 Locked</span>
              </div>
            )}
          </>
        );
      }

      // 7. DEEP CONTENT
      if (section.section === 'deep_content') {
        return (
          <>
            <ListingFaqs faqs={listing.faqs} />
            {listing.blog?.title && (
              <section style="background:white; border-radius:12px; box-shadow:0 2px 8px rgba(0,0,0,0.08); margin:1.5rem 0; overflow:hidden;">
                <details style="border:none; margin:0; padding:0;">
                  <summary style="padding:1.25rem; font-size:1.2rem; font-weight:600; color:#804000; cursor:pointer; background:#fff8f0; border-radius:12px 12px 0 0; list-style:none;">
                    📖 Read the Full Review
                    <span style="display:block; font-size:0.9rem; font-weight:400; color:#666; margin-top:0.25rem;">{listing.blog.title}</span>
                    <span style="display:inline-block; margin-top:0.5rem; font-size:0.8rem; color:#0066cc;">Tap to expand ↓</span>
                  </summary>
                  <div style="padding:1.25rem; line-height:1.8;">
                    <p style="font-style:italic; color:#666; margin-bottom:0.5rem;">{listing.blog.excerpt}</p>
                    <time datetime={listing.blog.lastModified} style="font-size:0.8rem; color:#999;">
                      🕐 Last updated: {new Date(listing.blog.lastModified).toLocaleDateString('en-KE', { year: 'numeric', month: 'long', day: 'numeric' })}
                    </time>
                    <div style="margin-top:1rem;">
                      <Fragment set:html={listing.blog.bodyHtml || ''} />
                    </div>
                  </div>
                </details>
              </section>
            )}
          </>
        );
      }

      return null;
    })}

    {/* COLLAPSIBLE INTERNAL LINKING */}
    {(siblingListings.length > 0 || sameNiche.length > 0 || sameLocation.length > 0) && (
      <details style="background:white; border-radius:12px; box-shadow:0 2px 8px rgba(0,0,0,0.08); margin:2rem 0; overflow:hidden; border:1px solid #e0e0e0;">
        <summary style="padding:1.25rem; font-size:1.15rem; font-weight:600; color:#003d80; cursor:pointer; background:#f8f9ff; list-style:none; display:flex; align-items:center; gap:0.5rem;">
          🌐 Explore More Options in {locationDisplay} & Other Locations
          <span style="font-size:0.8rem; color:#666; font-weight:400; margin-left:auto;">Tap to expand ↓</span>
        </summary>
        
        <div style="padding:1.25rem; background:#fff;">
          {siblingListings.length > 0 && (
            <div style="margin-bottom:1.5rem;">
              <h3 style="font-size:1.1rem; margin-top:0; padding-bottom:0.5rem; border-bottom:2px solid #e8e8e8;">🔍 More {nicheDisplay} in {locationDisplay}</h3>
              <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:0.75rem; margin-top:0.75rem;">
                {siblingListings.slice(0, 6).map((other: any) => (
                  <a href={`/${directoryData.directory}/${other.slug}/`} style="display:block; padding:0.85rem 1rem; background:#f8f9ff; border:1px solid #e0e6ff; color:#003d80; text-decoration:none; border-radius:10px; font-weight:600; font-size:0.95rem;">
                    🏠 {other.name}
                    <div style="font-size:0.8rem; color:#666; font-weight:400; margin-top:0.25rem;">
                      {other.priceCategory || `KSh ${other.priceNumeric?.toLocaleString('en-KE')}`}
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )}

          {sameNiche.length > 0 && (
            <div style="margin-bottom:1.5rem;">
              <h3 style="font-size:1.1rem; margin-top:0; padding-bottom:0.5rem; border-bottom:2px solid #e8e8e8;">📍 {nicheDisplay} in Other Locations</h3>
              <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:0.75rem; margin-top:0.75rem;">
                {sameNiche.map((dir: any) => (
                  <a href={`/${dir.directory}/`} style="display:block; padding:0.85rem 1rem; background:#f8f9ff; border:1px solid #e0e6ff; color:#003d80; text-decoration:none; border-radius:10px; font-weight:600; font-size:0.95rem;">
                    📍 {dir.nicheDisplay} in {dir.locationDisplay}
                  </a>
                ))}
              </div>
            </div>
          )}

          {sameLocation.length > 0 && (
            <div>
              <h3 style="font-size:1.1rem; margin-top:0; padding-bottom:0.5rem; border-bottom:2px solid #e8e8e8;">🏢 Other Categories in {locationDisplay}</h3>
              <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:0.75rem; margin-top:0.75rem;">
                {sameLocation.map((dir: any) => (
                  <a href={`/${dir.directory}/`} style="display:block; padding:0.85rem 1rem; background:#f8fff8; border:1px solid #e0ffe0; color:#1a7a3a; text-decoration:none; border-radius:10px; font-weight:600; font-size:0.95rem;">
                    🏢 {dir.nicheDisplay} in {dir.locationDisplay}
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>
      </details>
    )}

    <div style="margin:2rem 0; text-align:center;">
      <a href={`/${directoryData.directory}/`} style="display:inline-block; padding:0.75rem 1.5rem; background:#0066cc; color:white; text-decoration:none; border-radius:8px; font-weight:600;">
        ← Back to {dirLabel}
      </a>
    </div>

    <div id="lightbox" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.95); z-index:9999; align-items:center; justify-content:center; flex-direction:column;">
      <button id="lightboxClose" style="position:absolute; top:15px; right:15px; background:none; border:none; color:white; font-size:2rem; cursor:pointer; z-index:10000;">✕</button>
      <button id="lightboxPrev" style="position:absolute; left:10px; top:50%; transform:translateY(-50%); background:rgba(255,255,255,0.2); border:none; color:white; font-size:2rem; cursor:pointer; padding:0.5rem 1rem; border-radius:50%;">←</button>
      <img id="lightboxImg" src="" alt="" style="max-width:95%; max-height:85%; object-fit:contain; border-radius:8px;" />
      <p id="lightboxCaption" style="color:white; margin-top:1rem; font-size:0.9rem; text-align:center; padding:0 1rem;"></p>
      <button id="lightboxNext" style="position:absolute; right:10px; top:50%; transform:translateY(-50%); background:rgba(255,255,255,0.2); border:none; color:white; font-size:2rem; cursor:pointer; padding:0.5rem 1rem; border-radius:50%;">→</button>
    </div>

    <script set:html={`
      const galleryPhotos = ${JSON.stringify(allPhotos)};
      let currentPhotoIndex = 0;

      // FIX: Read More toggle for summary
      window.toggleSummary = function() {
        const desc = document.getElementById('summaryText');
        const btn = document.getElementById('summaryBtn');
        if (!desc || !btn) return;

        if (desc.style.webkitLineClamp === '3' || !desc.style.webkitLineClamp) {
          desc.style.display = 'block';
          desc.style.webkitLineClamp = 'unset';
          btn.innerHTML = 'Show Less <span>↑</span>';
        } else {
          desc.style.display = '-webkit-box';
          desc.style.webkitLineClamp = '3';
          btn.innerHTML = 'Read More <span>↓</span>';
        }
      };

      function openLightbox(index) {
        currentPhotoIndex = index;
        updateLightbox();
        document.getElementById('lightbox').style.display = 'flex';
        document.body.style.overflow = 'hidden';
      }

      function closeLightbox() {
        document.getElementById('lightbox').style.display = 'none';
        document.body.style.overflow = 'auto';
      }

      function updateLightbox() {
        const photo = galleryPhotos[currentPhotoIndex];
        if (!photo) return;
        document.getElementById('lightboxImg').src = photo.src;
        document.getElementById('lightboxImg').alt = photo.alt;
        document.getElementById('lightboxCaption').textContent = photo.alt + ' (' + (currentPhotoIndex + 1) + '/' + galleryPhotos.length + ')';
      }

      function nextPhoto() {
        currentPhotoIndex = (currentPhotoIndex + 1) % galleryPhotos.length;
        updateLightbox();
      }

      function prevPhoto() {
        currentPhotoIndex = (currentPhotoIndex - 1 + galleryPhotos.length) % galleryPhotos.length;
        updateLightbox();
      }

      document.addEventListener('click', function(e) {
        const img = e.target.closest('.gallery-photo');
        if (img) {
          const src = img.getAttribute('data-photo-src');
          const idx = galleryPhotos.findIndex(p => p.src === src);
          if (idx >= 0) openLightbox(idx);
        }
      });

      document.getElementById('lightboxClose').addEventListener('click', closeLightbox);
      document.getElementById('lightboxNext').addEventListener('click', nextPhoto);
      document.getElementById('lightboxPrev').addEventListener('click', prevPhoto);

      document.addEventListener('keydown', function(e) {
        if (document.getElementById('lightbox').style.display === 'flex') {
          if (e.key === 'Escape') closeLightbox();
          if (e.key === 'ArrowRight') nextPhoto();
          if (e.key === 'ArrowLeft') prevPhoto();
        }
      });
    `} />
  </main>

  <ChatWidget 
    mode="listing" 
    listingData={listing} 
    businessName={listing.name} 
  />

  <Footer 
    businessName={listing.name}
    phone={listing.phone}
    phoneDisplay={listing.phoneDisplay}
    whatsapp={listing.whatsapp}
  />
</BaseLayout>