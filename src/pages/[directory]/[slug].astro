---
import { getDirectoryData, getAllDirectorySlugs } from '../../lib/firestore';
import { getDirectoryConfig } from '../../lib/registry';
import {
  generateLocalBusinessSchema,
  generateHotelSchema,
  generateApartmentSchema,
  generateSchoolSchema,
  generateMedicalSchema,
  generateArticleSchema
} from '../../lib/schema';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PhoneButton from '../../components/PhoneButton.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import WrittenDirections from '../../components/WrittenDirections.astro';
import MapFacade from '../../components/MapFacade.astro';
import ListingFaqs from '../../components/ListingFaqs.astro';

export async function getStaticPaths() {
  const slugs = await getAllDirectorySlugs();
  const paths = [];
  
  for (const dirSlug of slugs) {
    const data = await getDirectoryData(dirSlug);
    if (data && data.listings) {
      for (const listing of data.listings) {
        paths.push({
          params: { directory: dirSlug, slug: listing.slug },
          props: { directoryData: data, listing: listing }
        });
      }
    }
  }
  
  return paths;
}

const { directoryData, listing } = Astro.props;
const config = getDirectoryConfig(directoryData.directory);
const niche = listing.nicheSpecific as any;
const amenities = niche?.amenities || niche?.facilities || niche?.services || [];

const dirLabel = directoryData.categoryTag 
  ? `${directoryData.categoryTag} ${directoryData.nicheDisplay} in ${directoryData.locationDisplay}`
  : `${directoryData.nicheDisplay} in ${directoryData.locationDisplay}`;

const pageTitle = `${listing.name} — ${dirLabel}`;
const pageDescription = listing.summary;

let schema = null;
if (directoryData.nicheSlug === 'guesthouse') schema = generateLocalBusinessSchema(listing, directoryData.directory);
else if (directoryData.nicheSlug === 'hotel') schema = generateHotelSchema(listing, directoryData.directory);
else if (directoryData.nicheSlug === 'apartment') schema = generateApartmentSchema(listing, directoryData.directory);
else if (directoryData.nicheSlug === 'school') schema = generateSchoolSchema(listing, directoryData.directory);
else if (directoryData.nicheSlug === 'health') schema = generateMedicalSchema(listing, directoryData.directory);

const articleSchema = listing.blog?.title ? generateArticleSchema(listing, `${Astro.url.origin}/${directoryData.directory}/${listing.slug}/`) : null;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  ogImage={listing.thumbnail}
  canonicalURL={`${Astro.url.origin}/${directoryData.directory}/${listing.slug}/`}
  lastModified={listing.lastEditedAt}
  geoCoordinates={listing.coordinates}
  geoPlacename={`${directoryData.locationDisplay}, Kenya`}
>
  <slot name="head">
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
    {articleSchema && <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />}
  </slot>

  <Header 
    breadcrumbs={[
      { label: 'Home', url: '/' },
      { label: dirLabel, url: `/${directoryData.directory}/` },
      { label: listing.name }
    ]} 
  />

  <main>
    {/* Hero Section */}
    <section style="background:white; border-radius:12px; overflow:hidden; box-shadow:0 2px 8px rgba(0,0,0,0.08); margin-bottom:1.5rem;">
      {listing.thumbnail && (
        <img src={listing.thumbnail} alt={listing.thumbnailAlt} width="800" height="400" loading="eager" style="border-radius:0; width:100%; max-height:400px; object-fit:cover;" />
      )}
      <div style="padding:1.5rem;">
        <h1 style="font-size:1.8rem; margin-bottom:0.5rem; line-height:1.3;">{listing.name}</h1>
        <p style="font-weight:bold; font-size:1.1rem; color:#1a7a3a; margin:0.5rem 0; background:#e8f4e8; display:inline-block; padding:0.3rem 0.9rem; border-radius:20px;">
          {listing.priceCategory || `KSh ${listing.priceNumeric?.toLocaleString('en-KE')}${config.priceSuffix}`}
        </p>
        <p style="font-size:1.05rem; color:#444; margin:0.75rem 0 0;">{listing.summary}</p>
      </div>
    </section>

    {/* Contact Buttons */}
    <div style="display:flex; gap:0.75rem; flex-wrap:wrap; margin:1.25rem 0;">
      <PhoneButton phone={listing.phone} display={listing.phoneDisplay} />
      <WhatsAppButton number={listing.whatsapp} message={listing.whatsappMessage} />
    </div>

    {/* Quick Facts */}
    {amenities.length > 0 && (
      <section style="background:white; padding:1.25rem; border-radius:12px; box-shadow:0 2px 8px rgba(0,0,0,0.08); margin:1rem 0;">
        <h2 style="margin-top:0; font-size:1.3rem;">Amenities & Features</h2>
        <div style="display:flex; flex-wrap:wrap; gap:0.5rem; margin-top:0.75rem;">
          {amenities.map((a: string) => (
            <span style="background:#f0f4ff; color:#003d80; padding:0.3rem 0.8rem; border-radius:20px; font-size:0.85rem;">✓ {a}</span>
          ))}
        </div>
      </section>
    )}

    {niche?.rooms != null && (
      <section style="background:white; padding:1.25rem; border-radius:12px; box-shadow:0 2px 8px rgba(0,0,0,0.08); margin:1rem 0;">
        <h2 style="margin-top:0; font-size:1.3rem;">Details</h2>
        <div style="margin-top:0.75rem;">
          <p style="margin:0.35rem 0;"><strong>Rooms:</strong> {niche.rooms}</p>
          {niche?.checkIn && <p style="margin:0.35rem 0;"><strong>Check-in:</strong> {niche.checkIn}</p>}
          {niche?.checkOut && <p style="margin:0.35rem 0;"><strong>Check-out:</strong> {niche.checkOut}</p>}
          {niche?.starRating && <p style="margin:0.35rem 0;"><strong>Star Rating:</strong> {niche.starRating} ⭐</p>}
          {niche?.apartmentType && <p style="margin:0.35rem 0;"><strong>Type:</strong> {niche.apartmentType}</p>}
          {niche?.furnished != null && <p style="margin:0.35rem 0;"><strong>Furnished:</strong> {niche.furnished ? 'Yes' : 'No'}</p>}
          {niche?.schoolType && <p style="margin:0.35rem 0;"><strong>School Type:</strong> {niche.schoolType}</p>}
          {niche?.curriculum && <p style="margin:0.35rem 0;"><strong>Curriculum:</strong> {niche.curriculum}</p>}
          {niche?.studentCount != null && <p style="margin:0.35rem 0;"><strong>Students:</strong> {niche.studentCount}</p>}
          {niche?.facilityType && <p style="margin:0.35rem 0;"><strong>Facility Type:</strong> {niche.facilityType}</p>}
          {niche?.doctorCount != null && <p style="margin:0.35rem 0;"><strong>Doctors:</strong> {niche.doctorCount}</p>}
          {niche?.visitingHours && <p style="margin:0.35rem 0;"><strong>Visiting Hours:</strong> {niche.visitingHours}</p>}
          {niche?.emergency != null && <p style="margin:0.35rem 0;"><strong>Emergency Services:</strong> {niche.emergency ? 'Yes' : 'No'}</p>}
          {niche?.insuranceAccepted && <p style="margin:0.35rem 0;"><strong>Insurance:</strong> {niche.insuranceAccepted}</p>}
        </div>
      </section>
    )}

    <WrittenDirections directions={listing.directions} />
    <MapFacade lat={listing.coordinates.lat} lng={listing.coordinates.lng} name={listing.name} />
    <ListingFaqs faqs={listing.faqs} />

    {/* Collapsible Blog Review */}
    {listing.blog?.title && (
      <section style="background:white; border-radius:12px; box-shadow:0 2px 8px rgba(0,0,0,0.08); margin:1.5rem 0; overflow:hidden;">
        <details style="border:none; margin:0; padding:0;">
          <summary style="padding:1.25rem; font-size:1.2rem; font-weight:600; color:#804000; cursor:pointer; background:#fff8f0; border-radius:12px 12px 0 0; list-style:none;">
            📝 Read Full Review: {listing.blog.title}
          </summary>
          <div style="padding:1.25rem; line-height:1.8;">
            <p style="font-style:italic; color:#666; margin-bottom:0.5rem;">{listing.blog.excerpt}</p>
            <time datetime={listing.blog.lastModified} style="font-size:0.8rem; color:#999;">
              🕐 Last updated: {new Date(listing.blog.lastModified).toLocaleDateString('en-KE', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
            <div style="margin-top:1rem;">
              <Fragment set:html={listing.blog.bodyHtml || ''} />
            </div>
          </div>
        </details>
      </section>
    )}

    {/* Back to Directory */}
    <div style="margin:2rem 0; text-align:center;">
      <a href={`/${directoryData.directory}/`} style="display:inline-block; padding:0.75rem 1.5rem; background:#0066cc; color:white; text-decoration:none; border-radius:8px; font-weight:600;">
        ← Back to {dirLabel}
      </a>
    </div>
  </main>

  <Footer />
</BaseLayout>