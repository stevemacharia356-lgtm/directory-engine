---
import { getAllDirectorySlugs, getDirectoryData, getAllBusinessSlugs, getBusinessData } from '../lib/firestore';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const slugs = await getAllDirectorySlugs();

const directories = [];
const limit = 10;
for (let i = 0; i < slugs.length; i += limit) {
  const batch = slugs.slice(i, i + limit);
  const results = await Promise.all(batch.map(slug => getDirectoryData(slug)));
  directories.push(...results.filter(Boolean));
}

// Group directories by location
const byLocation = new Map();
directories.forEach((dir: any) => {
  if (!dir) return;
  const key = dir.locationDisplay;
  if (!byLocation.has(key)) {
    byLocation.set(key, []);
  }
  byLocation.get(key).push(dir);
});

// Group directories by niche
const byNiche = new Map();
directories.forEach((dir: any) => {
  if (!dir) return;
  const key = dir.nicheDisplay;
  if (!byNiche.has(key)) {
    byNiche.set(key, []);
  }
  byNiche.get(key).push(dir);
});

// Convert to sorted arrays
const locations = Array.from(byLocation.entries())
  .sort((a, b) => a[0].localeCompare(b[0]))
  .map(([name, dirs]) => ({ name, dirs }));

const niches = Array.from(byNiche.entries())
  .sort((a, b) => a[0].localeCompare(b[0]))
  .map(([name, dirs]) => ({ name, dirs }));

// Fetch published business pages
const businessSlugs = await getAllBusinessSlugs();
const businesses = [];
for (const bizSlug of businessSlugs) {
  const biz = await getBusinessData(bizSlug);
  if (biz) businesses.push({ slug: bizSlug, ...biz });
}
---

<BaseLayout
  title="Kenya Accommodation & Business Directory — Find Guesthouses, Hotels, Shops & More"
  description="Comprehensive directory of accommodations and businesses across Kenya. Honest reviews, photos, prices, and contact details for guesthouses, hotels, shops, schools, and health facilities."
>
  <Header breadcrumbs={[{ label: 'Home' }]} />
  
  <main>
    <h1>Kenya Accommodation & Business Directory</h1>
    <p>Honest reviews and detailed information about accommodations and businesses across Kenya. Click a location to compare options, see photos, and get contact details.</p>

    {/* NEW: Browse by Location */}
    {locations.length > 0 && (
      <section style="margin-top:2.5rem;">
        <h2>🗺️ Browse by Location</h2>
        <p style="color:#555; margin-top:0.5rem;">Explore all categories in each Kenyan town and city.</p>
        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:1rem; margin-top:1rem;">
          {locations.map((loc: any) => (
            <div style="background:white; border:1px solid #e0e6ff; border-radius:12px; padding:1.25rem; box-shadow:0 2px 8px rgba(0,0,0,0.05);">
              <h3 style="margin:0 0 0.75rem 0; font-size:1.1rem; color:#003d80;">📍 {loc.name}</h3>
              <ul style="list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:0.4rem;">
                {loc.dirs.map((dir: any) => (
                  <li>
                    <a href={`/${dir.directory}/`} style="color:#0066cc; text-decoration:none; font-size:0.9rem; display:flex; justify-content:space-between; align-items:center; padding:0.35rem 0; border-bottom:1px dashed #f0f0f0;">
                      <span>{dir.nicheDisplay}</span>
                      <span style="color:#999; font-size:0.8rem;">{dir.listings.length} →</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>
    )}

    {/* NEW: Browse by Category */}
    {niches.length > 0 && (
      <section style="margin-top:2.5rem;">
        <h2>🏢 Browse by Category</h2>
        <p style="color:#555; margin-top:0.5rem;">Find the same type of business across all Kenyan locations.</p>
        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:1rem; margin-top:1rem;">
          {niches.map((n: any) => (
            <div style="background:white; border:1px solid #e0ffe0; border-radius:12px; padding:1.25rem; box-shadow:0 2px 8px rgba(0,0,0,0.05);">
              <h3 style="margin:0 0 0.75rem 0; font-size:1.1rem; color:#1a7a3a;">🏢 {n.name}</h3>
              <ul style="list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:0.4rem;">
                {n.dirs.map((dir: any) => (
                  <li>
                    <a href={`/${dir.directory}/`} style="color:#0066cc; text-decoration:none; font-size:0.9rem; display:flex; justify-content:space-between; align-items:center; padding:0.35rem 0; border-bottom:1px dashed #f0f0f0;">
                      <span>{dir.nicheDisplay} in {dir.locationDisplay}</span>
                      <span style="color:#999; font-size:0.8rem;">{dir.listings.length} →</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>
    )}

    <h2 style="margin-top:3rem;">📍 All Directories</h2>
    {directories.length === 0 ? (
      <p>No directories available yet. Check back soon.</p>
    ) : (
      <ul style="list-style:none; padding:0; display:grid; gap:1rem; grid-template-columns:repeat(auto-fit, minmax(250px, 1fr));">
        {directories.map(dir => (
          <li style="border:1px solid #e0e0e0; border-radius:8px; overflow:hidden;">
            <a href={`/${dir!.directory}/`} style="text-decoration:none; color:inherit; display:block;">
              <img src={dir!.heroImage} alt={dir!.heroImageAlt} width="400" height="200" loading="lazy" style="width:100%; height:200px; object-fit:cover;" />
              <div style="padding:1rem;">
                <h3 style="font-size:1.1rem; margin:0;">{dir!.nicheDisplay} in {dir!.locationDisplay}</h3>
                <p style="margin:0.5rem 0 0; color:#666;">{dir!.listings.length} places reviewed</p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    )}

    <h2 style="margin-top:3rem;">🏢 Featured Businesses</h2>
    {businesses.length === 0 ? (
      <p>No featured businesses yet. Check back soon.</p>
    ) : (
      <ul style="list-style:none; padding:0; display:grid; gap:1rem; grid-template-columns:repeat(auto-fit, minmax(250px, 1fr));">
        {businesses.map(biz => (
          <li style="border:1px solid #e0e0e0; border-radius:8px; overflow:hidden;">
            <a href={`/business/${biz.slug}/`} style="text-decoration:none; color:inherit; display:block;">
              {biz.heroImage ? <img src={biz.heroImage} alt={biz.heroImageAlt || biz.name} width="400" height="200" loading="lazy" style="width:100%; height:200px; object-fit:cover;" /> : <div style="width:100%; height:200px; background:#f0f0f0; display:flex; align-items:center; justify-content:center; color:#999;">No Image</div>}
              <div style="padding:1rem;">
                <h3 style="font-size:1.1rem; margin:0;">{biz.name}</h3>
                <p style="margin:0.25rem 0 0; color:#666;">{biz.location}</p>
                {biz.tagline && <p style="margin:0.25rem 0 0; color:#999; font-size:0.9rem;">{biz.tagline}</p>}
              </div>
            </a>
          </li>
        ))}
      </ul>
    )}
  </main>

  <Footer />
</BaseLayout>