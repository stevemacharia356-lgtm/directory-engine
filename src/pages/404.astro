---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Page Not Found | Kenya Accommodation Directory"
  description="The page you're looking for doesn't exist. Browse our directory of accommodations across Kenya."
>
  <main style="text-align:center; padding:3rem 1rem;">
    <h1>Page Not Found</h1>
    <p>The page you're looking for doesn't exist or has moved.</p>
    <a href="/" style="display:inline-block; margin-top:1rem; padding:0.75rem 1.5rem; background:#0066cc; color:white; text-decoration:none; border-radius:4px;">
      ← Browse All Locations
    </a>
  </main>
</BaseLayout>