---
// AI FAQ Assistant Chat Widget
// Add this component to any listing page
// It fetches answers from the generateFAQAnswer Cloud Function

export interface Props {
  listingName?: string;
  listingSlug?: string;
  directorySlug?: string;
  listingData?: any;
}

const { listingName, listingSlug, directorySlug, listingData } = Astro.props;
---

<div class="chat-widget-container">
  <button id="chatToggle" class="chat-toggle" aria-label="Open chat assistant">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
    </svg>
    <span>Ask AI</span>
  </button>

  <div id="chatWindow" class="chat-window" style="display:none;">
    <div class="chat-header">
      <span class="chat-header-title">🤖 FAQ Assistant</span>
      <button id="chatClose" class="chat-close" aria-label="Close chat">✕</button>
    </div>
    <div id="chatMessages" class="chat-messages">
      <div class="chat-message bot">
        <div class="message-bubble">
          Hello! I'm the AI assistant for <strong>${listingName || 'this business'}</strong>.
          Ask me anything about their services, location, hours, or more!
        </div>
      </div>
    </div>
    <div class="chat-input-area">
      <input type="text" id="chatInput" placeholder="Ask a question..." class="chat-input">
      <button id="chatSend" class="chat-send">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="22" y1="2" x2="11" y2="13"></line>
          <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
        </svg>
      </button>
    </div>
    <div id="chatTyping" class="chat-typing" style="display:none;">
      <span></span><span></span><span></span>
    </div>
  </div>
</div>

<style>
  .chat-widget-container {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 1000;
    font-family: system-ui, -apple-system, sans-serif;
  }

  .chat-toggle {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 20px;
    background: #0066cc;
    color: white;
    border: none;
    border-radius: 50px;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(0, 102, 204, 0.35);
    transition: all 0.25s ease;
    position: relative;
  }

  .chat-toggle:hover {
    transform: scale(1.04);
    box-shadow: 0 6px 24px rgba(0, 102, 204, 0.45);
  }

  .chat-toggle:active {
    transform: scale(0.94);
  }

  .chat-toggle svg {
    flex-shrink: 0;
  }

  .chat-window {
    position: absolute;
    bottom: 80px;
    right: 0;
    width: 380px;
    max-width: calc(100vw - 32px);
    height: 460px;
    max-height: calc(100vh - 140px);
    background: #ffffff;
    border-radius: 16px;
    box-shadow: 0 8px 40px rgba(0, 0, 0, 0.18);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    animation: chatSlideUp 0.3s ease forwards;
  }

  @keyframes chatSlideUp {
    from {
      opacity: 0;
      transform: translateY(16px) scale(0.94);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .chat-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 18px;
    background: #0066cc;
    color: white;
    flex-shrink: 0;
  }

  .chat-header-title {
    font-size: 15px;
    font-weight: 600;
  }

  .chat-close {
    background: none;
    border: none;
    color: white;
    font-size: 20px;
    cursor: pointer;
    opacity: 0.7;
    transition: opacity 0.2s;
    padding: 0 4px;
  }

  .chat-close:hover {
    opacity: 1;
  }

  .chat-messages {
    flex: 1;
    overflow-y: auto;
    padding: 16px 18px;
    background: #f8f9fa;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .chat-messages::-webkit-scrollbar {
    width: 4px;
  }

  .chat-messages::-webkit-scrollbar-thumb {
    background: #ccc;
    border-radius: 4px;
  }

  .chat-message {
    display: flex;
    animation: messageIn 0.3s ease forwards;
  }

  @keyframes messageIn {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .chat-message.user {
    justify-content: flex-end;
  }

  .chat-message.bot {
    justify-content: flex-start;
  }

  .message-bubble {
    max-width: 85%;
    padding: 10px 14px;
    border-radius: 12px;
    font-size: 14px;
    line-height: 1.5;
    word-wrap: break-word;
  }

  .chat-message.user .message-bubble {
    background: #0066cc;
    color: white;
    border-bottom-right-radius: 4px;
  }

  .chat-message.bot .message-bubble {
    background: white;
    color: #1a1a2e;
    border-bottom-left-radius: 4px;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.06);
  }

  .chat-message.bot .message-bubble strong {
    color: #0066cc;
  }

  .chat-input-area {
    display: flex;
    gap: 8px;
    padding: 12px 16px;
    border-top: 1px solid #e9ecef;
    background: white;
    flex-shrink: 0;
  }

  .chat-input {
    flex: 1;
    padding: 10px 14px;
    border: 1px solid #ddd;
    border-radius: 24px;
    font-size: 14px;
    outline: none;
    transition: border-color 0.2s;
  }

  .chat-input:focus {
    border-color: #0066cc;
  }

  .chat-input::placeholder {
    color: #999;
  }

  .chat-send {
    width: 44px;
    height: 44px;
    border: none;
    border-radius: 50%;
    background: #0066cc;
    color: white;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s;
    flex-shrink: 0;
  }

  .chat-send:hover {
    background: #0052a3;
  }

  .chat-send:active {
    transform: scale(0.92);
  }

  .chat-typing {
    display: none;
    padding: 10px 18px;
    gap: 4px;
    background: #f8f9fa;
  }

  .chat-typing span {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #999;
    animation: typingBounce 1.2s infinite;
  }

  .chat-typing span:nth-child(2) {
    animation-delay: 0.2s;
  }

  .chat-typing span:nth-child(3) {
    animation-delay: 0.4s;
  }

  @keyframes typingBounce {
    0%, 60%, 100% {
      transform: translateY(0);
      opacity: 0.4;
    }
    30% {
      transform: translateY(-8px);
      opacity: 1;
    }
  }

  /* Mobile adjustments */
  @media (max-width: 600px) {
    .chat-widget-container {
      bottom: 16px;
      right: 16px;
    }

    .chat-toggle {
      padding: 10px 16px;
      font-size: 13px;
      border-radius: 40px;
    }

    .chat-toggle span {
      display: none;
    }

    .chat-toggle svg {
      width: 22px;
      height: 22px;
    }

    .chat-window {
      bottom: 72px;
      width: calc(100vw - 32px);
      height: calc(100vh - 140px);
      max-height: 500px;
      border-radius: 12px;
    }

    .message-bubble {
      font-size: 13px;
    }
  }
</style>

<script>
  (function() {
    const listingName = '${listingName || ''}';
    const listingSlug = '${listingSlug || ''}';
    const directorySlug = '${directorySlug || ''}';
    const listingData = ${JSON.stringify(listingData || {})};

    // Elements
    const toggle = document.getElementById('chatToggle');
    const windowEl = document.getElementById('chatWindow');
    const closeBtn = document.getElementById('chatClose');
    const input = document.getElementById('chatInput');
    const sendBtn = document.getElementById('chatSend');
    const messages = document.getElementById('chatMessages');
    const typing = document.getElementById('chatTyping');

    let isOpen = false;
    let isWaiting = false;

    // Toggle chat
    function toggleChat() {
      isOpen = !isOpen;
      windowEl.style.display = isOpen ? 'flex' : 'none';
      if (isOpen) {
        input.focus();
        // Scroll to bottom
        messages.scrollTop = messages.scrollHeight;
      }
    }

    toggle.addEventListener('click', toggleChat);
    closeBtn.addEventListener('click', toggleChat);

    // Send message
    async function sendMessage() {
      const question = input.value.trim();
      if (!question || isWaiting) return;

      // Add user message
      addMessage(question, 'user');
      input.value = '';
      isWaiting = true;
      typing.style.display = 'flex';
      messages.scrollTop = messages.scrollHeight;

      try {
        // Get the Firebase functions instance
        const functions = firebase.functions();
        const generateFAQ = functions.httpsCallable('generateFAQAnswer');

        // Prepare listing data for the function
        const contextData = {
          name: listingData.name || listingName,
          niche: listingData.niche || '',
          location: listingData.location || '',
          summary: listingData.summary || '',
          phoneDisplay: listingData.phoneDisplay || listingData.phone || '',
          phone: listingData.phone || '',
          directions: listingData.directions || '',
          faqs: listingData.faqs || [],
          blog: listingData.blog || null
        };

        const result = await generateFAQ({
          question: question,
          listingData: contextData
        });

        const answer = result.data.answer || 'I couldn\'t process your question. Please try again.';
        addMessage(answer, 'bot');
      } catch (error) {
        console.error('FAQ error:', error);
        const fallback = listingData.phoneDisplay || listingData.phone 
          ? `I'm having trouble connecting. Please contact ${listingData.name || 'the business'} at ${listingData.phoneDisplay || listingData.phone} for assistance.`
          : 'I\'m having trouble connecting. Please try again in a moment.';
        addMessage(fallback, 'bot');
      }

      isWaiting = false;
      typing.style.display = 'none';
      messages.scrollTop = messages.scrollHeight;
    }

    // Add message to chat
    function addMessage(text, sender) {
      const div = document.createElement('div');
      div.className = `chat-message ${sender}`;
      
      const bubble = document.createElement('div');
      bubble.className = 'message-bubble';
      bubble.innerHTML = text.replace(/\n/g, '<br>');
      
      div.appendChild(bubble);
      messages.appendChild(div);
      messages.scrollTop = messages.scrollHeight;
    }

    // Event listeners
    sendBtn.addEventListener('click', sendMessage);
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        sendMessage();
      }
    });

    // Ensure firebase is available
    if (typeof firebase === 'undefined') {
      console.warn('Firebase not loaded. Chat widget will not work.');
    }

    // Add fallback if listing data is empty
    if (!listingData || Object.keys(listingData).length === 0) {
      console.warn('No listing data provided to chat widget.');
    }
  })();
</script>