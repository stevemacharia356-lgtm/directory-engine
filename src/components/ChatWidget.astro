---
export interface Props {
  mode: 'listing' | 'directory';
  listingData?: any;
  directoryData?: any;
  businessName?: string;
}

const { mode, listingData, directoryData, businessName } = Astro.props;
const title = businessName || (directoryData ? directoryData.locationDisplay : 'this site');
---

<div class="chat-widget-container">
  <button id="chatToggle" class="chat-toggle" aria-label="Open chat assistant">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
    </svg>
    <span>Ask AI</span>
  </button>

  <div id="chatWindow" class="chat-window" style="display:none;">
    <div class="chat-header">
      <span class="chat-header-title">🤖 Kedirectory AI</span>
      <button id="chatClose" class="chat-close" aria-label="Close chat">✕</button>
    </div>
    
    <div id="chatMessages" class="chat-messages">
      <!-- Initial Welcome Message -->
      <div class="chat-message bot">
        <div class="avatar bot-avatar">AI</div>
        <div class="message-bubble">
          Hello! I'm the <strong>Kedirectory AI assistant</strong> for <strong>{mode === 'directory' ? `${directoryData?.nicheDisplay} in ${directoryData?.locationDisplay}` : businessName}</strong>.
          <br /><br />
          {mode === 'directory' ? 'Ask me to compare prices, find a specific amenity, or recommend a place!' : 'Ask me anything about their services, location, or hours!'}
        </div>
      </div>
    </div>

    <div class="chat-input-area">
      <input type="text" id="chatInput" placeholder="Ask a question..." class="chat-input">
      <button id="chatSend" class="chat-send">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="22" y1="2" x2="11" y2="13"></line>
          <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
        </svg>
      </button>
    </div>
    
    <div id="chatTyping" class="chat-typing" style="display:none;">
      <div class="avatar bot-avatar">AI</div>
      <div class="typing-dots"><span></span><span></span><span></span></div>
    </div>
  </div>
</div>

<style is:global>
  .chat-widget-container { position: fixed; bottom: 24px; right: 24px; z-index: 9999; font-family: system-ui, -apple-system, sans-serif; }
  
  .chat-toggle { display: flex; align-items: center; gap: 8px; padding: 12px 20px; background: #0066cc; color: white; border: none; border-radius: 50px; font-size: 15px; font-weight: 600; cursor: pointer; box-shadow: 0 4px 16px rgba(0, 102, 204, 0.35); transition: all 0.25s ease; }
  .chat-toggle:hover { transform: scale(1.04); box-shadow: 0 6px 24px rgba(0, 102, 204, 0.45); }
  
  .chat-window { position: absolute; bottom: 80px; right: 0; width: 380px; max-width: calc(100vw - 32px); height: 500px; max-height: calc(100vh - 140px); background: #ffffff; border-radius: 16px; box-shadow: 0 8px 40px rgba(0, 0, 0, 0.18); display: flex; flex-direction: column; overflow: hidden; animation: chatSlideUp 0.3s ease forwards; }
  @keyframes chatSlideUp { from { opacity: 0; transform: translateY(16px) scale(0.98); } to { opacity: 1; transform: translateY(0) scale(1); } }
  
  .chat-header { display: flex; justify-content: space-between; align-items: center; padding: 14px 18px; background: #0066cc; color: white; flex-shrink: 0; }
  .chat-header-title { font-size: 15px; font-weight: 600; display: flex; align-items: center; gap: 6px; }
  .chat-close { background: none; border: none; color: white; font-size: 20px; cursor: pointer; opacity: 0.7; padding: 4px; }
  .chat-close:hover { opacity: 1; }
  
  .chat-messages { flex: 1; overflow-y: auto; padding: 16px 18px; background: #f8f9fa; display: flex; flex-direction: column; gap: 16px; }
  
  /* Message Rows */
  .chat-message { display: flex; align-items: flex-end; gap: 8px; animation: messageIn 0.3s ease forwards; width: 100%; }
  @keyframes messageIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
  
  .chat-message.user { flex-direction: row-reverse; }
  
  /* Avatars */
  .avatar { width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: bold; flex-shrink: 0; }
  .bot-avatar { background: #e6f0ff; color: #0066cc; border: 1px solid #b3d4ff; }
  .user-avatar { background: #0066cc; color: white; }

  /* Bubbles */
  .message-bubble { max-width: 80%; padding: 12px 16px; border-radius: 16px; font-size: 14px; line-height: 1.6; word-wrap: break-word; }
  
  /* Bot Bubble (Left) */
  .chat-message.bot .message-bubble { background: white; color: #1a1a2e; border-bottom-left-radius: 4px; box-shadow: 0 2px 6px rgba(0,0,0,0.06); border: 1px solid #e9ecef; }
  
  /* User Bubble (Right) */
  .chat-message.user .message-bubble { background: #0066cc; color: white; border-bottom-right-radius: 4px; }
  
  /* Input Area */
  .chat-input-area { display: flex; gap: 8px; padding: 12px 16px; border-top: 1px solid #e9ecef; background: white; flex-shrink: 0; }
  .chat-input { flex: 1; padding: 12px 16px; border: 1px solid #ddd; border-radius: 24px; font-size: 14px; outline: none; transition: border-color 0.2s; }
  .chat-input:focus { border-color: #0066cc; }
  .chat-send { width: 44px; height: 44px; border: none; border-radius: 50%; background: #0066cc; color: white; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: transform 0.15s; }
  .chat-send:active { transform: scale(0.92); }
  
  /* Typing Indicator */
  .chat-typing { display: none; align-items: flex-end; gap: 8px; padding: 0 18px 16px; background: #f8f9fa; }
  .typing-dots { background: white; padding: 12px 16px; border-radius: 16px; border-bottom-left-radius: 4px; box-shadow: 0 2px 6px rgba(0,0,0,0.06); border: 1px solid #e9ecef; display: flex; gap: 4px; align-items: center; height: 42px; }
  .typing-dots span { display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: #999; animation: typingBounce 1.2s infinite; }
  .typing-dots span:nth-child(2) { animation-delay: 0.2s; }
  .typing-dots span:nth-child(3) { animation-delay: 0.4s; }
  @keyframes typingBounce { 0%, 60%, 100% { transform: translateY(0); opacity: 0.4; } 30% { transform: translateY(-4px); opacity: 1; } }
  
  @media (max-width: 600px) {
    .chat-widget-container { bottom: 16px; right: 16px; }
    .chat-toggle span { display: none; }
    .chat-window { width: calc(100vw - 32px); bottom: 72px; height: 80vh; }
  }
</style>

<script define:vars={{ mode, listingData, directoryData, businessName }}>
  const toggle = document.getElementById('chatToggle');
  const windowEl = document.getElementById('chatWindow');
  const closeBtn = document.getElementById('chatClose');
  const input = document.getElementById('chatInput');
  const sendBtn = document.getElementById('chatSend');
  const messages = document.getElementById('chatMessages');
  const typing = document.getElementById('chatTyping');

  let isOpen = false;
  let isWaiting = false;

  function toggleChat() {
    isOpen = !isOpen;
    windowEl.style.display = isOpen ? 'flex' : 'none';
    if (isOpen) input.focus();
  }

  toggle.addEventListener('click', toggleChat);
  closeBtn.addEventListener('click', toggleChat);

  async function sendMessage() {
    const question = input.value.trim();
    if (!question || isWaiting) return;

    addMessage(question, 'user');
    input.value = '';
    isWaiting = true;
    typing.style.display = 'flex';
    messages.scrollTop = messages.scrollHeight;

    try {
      const functions = firebase.functions();
      const askAssistant = functions.httpsCallable('askDirectoryAssistant');

      let contextData = {};
      if (mode === 'listing' && listingData) {
        contextData = {
          name: listingData.name,
          niche: listingData.niche || '',
          location: listingData.location || '',
          summary: listingData.summary || '',
          phoneDisplay: listingData.phoneDisplay || listingData.phone || '',
          phone: listingData.phone || '',
          faqs: listingData.faqs || [],
          blog: listingData.blog || null,
          nicheSpecific: listingData.nicheSpecific || {}
        };
      } else if (mode === 'directory' && directoryData) {
        contextData = {
          nicheDisplay: directoryData.nicheDisplay,
          locationDisplay: directoryData.locationDisplay,
          listings: directoryData.listings || []
        };
      }

      const result = await askAssistant({
        question: question,
        mode: mode,
        listingData: mode === 'listing' ? contextData : null,
        directoryData: mode === 'directory' ? contextData : null
      });

      addMessage(result.data.answer || 'I could not process your question.', 'bot');
    } catch (error) {
      console.error('FAQ error:', error);
      addMessage('I am having trouble connecting. Please try again.', 'bot');
    }

    isWaiting = false;
    typing.style.display = 'none';
    messages.scrollTop = messages.scrollHeight;
  }

  function addMessage(text, sender) {
    const div = document.createElement('div');
    div.className = 'chat-message ' + sender;

    // Avatar
    const avatar = document.createElement('div');
    avatar.className = 'avatar ' + (sender === 'bot' ? 'bot-avatar' : 'user-avatar');
    avatar.textContent = sender === 'bot' ? 'AI' : 'You';

    // Bubble
    const bubble = document.createElement('div');
    bubble.className = 'message-bubble';
    
    // Format text (Bold + Line Breaks)
    let formattedText = text
      .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>') // Convert **bold** to <strong>
      .replace(/\n/g, '<br>');
      
    bubble.innerHTML = formattedText;
    
    // For user messages, append avatar after bubble so it sits on the right
    if (sender === 'user') {
      div.appendChild(bubble);
      div.appendChild(avatar);
    } else {
      div.appendChild(avatar);
      div.appendChild(bubble);
    }
    
    messages.appendChild(div);
    messages.scrollTop = messages.scrollHeight;
  }

  sendBtn.addEventListener('click', sendMessage);
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      sendMessage();
    }
  });
</script>