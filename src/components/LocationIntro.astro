---
interface Props {
  nicheDisplay: string;
  locationDisplay: string;
  description: string;
  heroImage: string;
  heroImageAlt: string;
}

const { nicheDisplay, locationDisplay, description, heroImage, heroImageAlt } = Astro.props;

// Check if description is long enough to need a toggle (e.g., over 180 chars)
const isLong = description && description.length > 180;
---

<section>
  <h1 style="font-size:1.8rem; margin-bottom:0.5rem; line-height:1.3;">{nicheDisplay} in {locationDisplay} — Complete Guide</h1>
  
  <img 
    src={heroImage} 
    alt={heroImageAlt}
    width="1200"
    height="600"
    loading="eager"
    decoding="async"
    style="border-radius:12px; margin:1rem 0; width:100%; height:auto; object-fit:cover; box-shadow:0 2px 8px rgba(0,0,0,0.08);"
  />
  
  {description && (
    <div style="background:white; padding:1.25rem; border-radius:12px; box-shadow:0 2px 8px rgba(0,0,0,0.05); border:1px solid #e0e0e0; margin-bottom:1.5rem;">
      
      <div class="location-description" style={`font-size:1.05rem; line-height:1.8; color:#444; ${isLong ? 'display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;' : ''}`} id="locationDesc">
        {description.split('\n\n').map(paragraph => (
          <p style="margin-bottom:1rem;">{paragraph}</p>
        ))}
      </div>

      {isLong && (
        <button 
          id="toggleLocationDesc" 
          onclick="toggleLocation()" 
          style="background:none; border:none; color:#0066cc; font-weight:600; font-size:0.95rem; cursor:pointer; padding:0; margin-top:0.5rem; display:flex; align-items:center; gap:0.25rem;"
        >
          Read More about {locationDisplay} <span>↓</span>
        </button>
      )}
    </div>
  )}
</section>

<script is:inline>
  function toggleLocation() {
    const desc = document.getElementById('locationDesc');
    const btn = document.getElementById('toggleLocationDesc');
    
    if (desc.style.webkitLineClamp === '3' || !desc.style.webkitLineClamp) {
      // Expand
      desc.style.display = 'block';
      desc.style.webkitLineClamp = 'unset';
      btn.innerHTML = 'Show Less <span>↑</span>';
    } else {
      // Collapse
      desc.style.display = '-webkit-box';
      desc.style.webkitLineClamp = '3';
      btn.innerHTML = 'Read More about ' + '{locationDisplay}' + ' <span>↓</span>';
    }
  }
</script>