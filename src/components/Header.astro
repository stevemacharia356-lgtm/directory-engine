---
export interface Props {
  breadcrumbs: Array<{ label: string; url?: string }>;
}

const { breadcrumbs } = Astro.props;

const filteredCrumbs = breadcrumbs.filter(c => c.url);
const crumbItems = filteredCrumbs.map((crumb, i) => ({
  '@type': 'ListItem',
  position: i + 1,
  name: crumb.label,
  item: `https://kedirectory.co.ke${crumb.url}`
}));
---

<header>
  <nav aria-label="Breadcrumb">
    <ol style="display:flex; gap:0.5rem; list-style:none; padding:1rem 0; font-size:0.9rem;">
      {breadcrumbs.map((crumb, i) => (
        <li>
          {crumb.url ? <a href={crumb.url}>{crumb.label}</a> : <span>{crumb.label}</span>}
          {i < breadcrumbs.length - 1 && <span aria-hidden="true"> / </span>}
        </li>
      ))}
    </ol>
  </nav>
</header>

{crumbItems.length > 0 && (
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: crumbItems
  })} />
)}