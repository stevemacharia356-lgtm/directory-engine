---
export interface Props {
  breadcrumbs: Array<{ label: string; url?: string }>;
}

const { breadcrumbs } = Astro.props;

const filteredCrumbs = breadcrumbs.filter(c => c.url);
const crumbItems = filteredCrumbs.map((crumb, i) => ({
  '@type': 'ListItem',
  position: i + 1,
  name: crumb.label,
  item: `https://kedirectory.co.ke${crumb.url}`
}));
---

<header style="position:sticky; top:0; z-index:100; background:white; border-bottom:1px solid #e8e8e8; box-shadow:0 1px 4px rgba(0,0,0,0.05); padding:0.75rem 1rem; margin:0 -1rem 1.5rem;">
  <nav aria-label="Breadcrumb">
    <ol style="display:flex; gap:0.35rem; list-style:none; font-size:0.85rem; flex-wrap:wrap;">
      {breadcrumbs.map((crumb, i) => (
        <li>
          {crumb.url ? <a href={crumb.url} style="color:#0066cc; font-weight:500;">{crumb.label}</a> : <span style="color:#555; font-weight:600;">{crumb.label}</span>}
          {i < breadcrumbs.length - 1 && <span aria-hidden="true" style="color:#bbb;"> / </span>}
        </li>
      ))}
    </ol>
  </nav>
</header>

{crumbItems.length > 0 && (
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: crumbItems
  })} />
)}