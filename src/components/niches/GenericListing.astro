---
import type { Listing } from '../../lib/firestore';
import PhoneButton from '../PhoneButton.astro';
import WhatsAppButton from '../WhatsAppButton.astro';

interface Props {
  listing: Listing;
  reviewAnchorId: string;
  index: number;
}

const { listing, reviewAnchorId, index } = Astro.props;
const niche = listing.nicheSpecific as any;
const services = niche?.services || niche?.amenities || niche?.facilities || [];
---

<section id={listing.slug} style="background:white; border-radius:12px; padding:1.25rem; margin:1.25rem 0; box-shadow:0 2px 8px rgba(0,0,0,0.08); border:1px solid #f0f0f0;">
  {listing.thumbnail && (
    <img src={listing.thumbnail} alt={listing.thumbnailAlt} width="800" height="400" loading={index === 0 ? 'eager' : 'lazy'} style="border-radius:10px; width:100%; height:auto; object-fit:cover; margin-bottom:1rem;" />
  )}
  
  <h3 style="margin:0 0 0.5rem 0; font-size:1.25rem; line-height:1.3;">{index + 1}. {listing.name}</h3>
  <p style="font-weight:bold; font-size:1.1rem; color:#1a7a3a; margin:0.25rem 0; background:#e8f4e8; display:inline-block; padding:0.25rem 0.75rem; border-radius:20px;">
    {listing.priceCategory || `KSh ${listing.priceNumeric?.toLocaleString('en-KE')}`}
  </p>
  <p style="margin:0.5rem 0; color:#555;">{listing.summary}</p>
  
  {services.length > 0 && (
    <div style="display:flex; flex-wrap:wrap; gap:0.5rem; margin:0.75rem 0;">
      {services.slice(0, 4).map((s: string) => (
        <span style="background:#f0f4ff; color:#003d80; padding:0.25rem 0.75rem; border-radius:20px; font-size:0.8rem;">✓ {s}</span>
      ))}
      {services.length > 4 && <span style="color:#999; font-size:0.8rem;">+ more</span>}
    </div>
  )}

  <div style="display:flex; gap:0.75rem; flex-wrap:wrap; margin:0.75rem 0;">
    <PhoneButton phone={listing.phone} display={listing.phoneDisplay} />
    <WhatsAppButton number={listing.whatsapp} message={listing.whatsappMessage} />
  </div>

  <a href={`/${listing.slug}/`} style="display:inline-block; margin-top:0.5rem; padding:0.6rem 1.25rem; background:#0066cc; color:white; text-decoration:none; border-radius:8px; font-weight:600; font-size:0.95rem;">
    See Full Details →
  </a>
</section>