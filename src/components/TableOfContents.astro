---
interface Section {
  id: string;
  label: string;
}

const { sections = [] } = Astro.props as { sections: Section[] };
---

<nav aria-label="Table of Contents" style="background:#f8f8f8; padding:1rem; border-radius:8px; margin:1rem 0;">
  <h2 style="margin-top:0;">On This Page</h2>
  <ol>
    {sections.map(section => (
      <li><a href={`#${section.id}`}>{section.label}</a></li>
    ))}
  </ol>
</nav>